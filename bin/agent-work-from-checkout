set -Eeuo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -z "${UV_CACHE_DIR:-}" ]]; then
    UV_CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/uv"
    export UV_CACHE_DIR
fi
exec uv run --project "$project_root" agent-work "$@"
