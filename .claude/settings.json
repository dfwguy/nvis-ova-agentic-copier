{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(uv run ty check *)",
      "Bash(uv run pre-commit run *)",
      "Bash(uv run tox *)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.cache/pre-commit"
      ]
    }
  }
}
