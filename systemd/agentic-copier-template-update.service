[Unit]
Description=Preview one guarded Copier template update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agentic-copier-template-update/template-update.env
ExecStart=/usr/bin/env ${AGENT_WORK_DIRENV} exec ${AGENT_WORK_CHECKOUT} ${AGENT_WORK_CHECKOUT}/bin/agent-work-from-checkout template update --candidate-revision ${TEMPLATE_UPDATE_CANDIDATE_REVISION} --project-root ${AGENT_WORK_CHECKOUT}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-copier-template-update
TimeoutStartSec=190min
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30s
SendSIGKILL=yes
