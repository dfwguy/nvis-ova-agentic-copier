[Unit]
Description=Run one bounded agent-work GitLab pass
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=AGENT_WORK_LOG_TAG={{ project_slug }}-agent-work
EnvironmentFile=%h/.config/{{ project_slug }}-agent-work/agent-work.env
ExecStart=/usr/bin/env bash ${AGENT_WORK_CHECKOUT}/scripts/agent-work-systemd-run.sh --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ project_slug }}-agent-work
TimeoutStartSec=90min
