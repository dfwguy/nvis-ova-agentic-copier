{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.example/schemas/work-item-result-v1.schema.json",
  "title": "Work-item result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "run_id", "mode", "outcome", "summary", "tests", "findings", "next_action", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["inspect", "publish"]},
    "outcome": {"enum": ["completed", "awaiting_human", "retry", "dead_letter"]},
    "summary": {"type": "string", "minLength": 1},
    "branch": {"type": ["string", "null"], "minLength": 1},
    "branch_tip": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"},
    "merge_request_url": {"type": ["string", "null"], "format": "uri"},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "next_action": {"type": "string"},
    "error": {"type": ["object", "null"], "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"}}}
  },
  "$defs": {
    "test_result": {"type": "object", "additionalProperties": false, "required": ["command", "status"], "properties": {"command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "skipped"]}, "detail": {"type": "string"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["classification", "summary"], "properties": {"classification": {"enum": ["major", "minor", "existing", "blocker"]}, "summary": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "issue_url": {"type": "string", "format": "uri"}}}
  },
  "allOf": [
    {"if": {"required": ["mode"], "properties": {"mode": {"const": "inspect"}}}, "then": {"properties": {"branch": {"const": null}, "branch_tip": {"const": null}, "merge_request_url": {"const": null}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "completed"}}}, "then": {"properties": {"error": {"const": null}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "retry"}}}, "then": {"required": ["error", "next_action"], "properties": {"error": {"type": "object", "properties": {"retryable": {"const": true}}}, "next_action": {"minLength": 1}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "dead_letter"}}}, "then": {"required": ["error", "next_action"], "properties": {"error": {"type": "object", "properties": {"retryable": {"const": false}}}, "next_action": {"minLength": 1}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "awaiting_human"}}}, "then": {"required": ["next_action"], "properties": {"next_action": {"minLength": 1}}}},
    {"if": {"required": ["mode", "outcome"], "properties": {"mode": {"const": "inspect"}, "outcome": {"const": "awaiting_human"}}}, "then": {"properties": {"error": {"type": "object"}}}},
    {"if": {"required": ["mode", "outcome"], "properties": {"mode": {"const": "publish"}, "outcome": {"const": "completed"}}}, "then": {"required": ["branch", "branch_tip", "merge_request_url"], "properties": {"branch": {"type": "string", "minLength": 1}, "branch_tip": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "merge_request_url": {"type": "string", "format": "uri"}, "error": {"const": null}}}},
    {"if": {"required": ["mode", "outcome"], "properties": {"mode": {"const": "publish"}, "outcome": {"const": "awaiting_human"}}}, "then": {"oneOf": [{"required": ["branch", "branch_tip", "merge_request_url"], "properties": {"branch": {"type": "string", "minLength": 1}, "branch_tip": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "merge_request_url": {"type": "string", "format": "uri"}, "error": {"const": null}}}, {"properties": {"branch": {"const": null}, "branch_tip": {"const": null}, "merge_request_url": {"const": null}, "error": {"type": "object"}}}]}},
    {"if": {"required": ["branch_tip"], "properties": {"branch_tip": {"type": "string"}}}, "then": {"required": ["branch"], "properties": {"branch": {"type": "string", "minLength": 1}}}},
    {"if": {"required": ["merge_request_url"], "properties": {"merge_request_url": {"type": "string"}}}, "then": {"required": ["branch", "branch_tip"], "properties": {"mode": {"const": "publish"}, "branch": {"type": "string", "minLength": 1}, "branch_tip": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}}}}
  ]
}
