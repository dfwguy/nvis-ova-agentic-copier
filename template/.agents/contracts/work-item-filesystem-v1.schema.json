{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "repository", "title", "body", "acceptance_criteria"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "body": {"type": "string", "maxLength": 65536},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  }
}
