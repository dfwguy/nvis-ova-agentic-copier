# Import Testing Guidelines

> **Note**: Use these patterns when testing import-related functionality, module dependencies, or import error handling.

## Core Import Testing Principles

- Test both successful and failed imports
- Use `monkeypatch` to simulate import failures
- Clear module cache when testing import retries
- Test conditional imports and optional dependencies
- Mock external dependencies that may not be available in test environment

## Testing Import Failures

### Basic Import Failure Testing

```python
import builtins
import sys
import pytest

def test_import_failure_with_monkeypatch(monkeypatch):
    """Test that import failures are handled gracefully."""
    # Setup failure condition
    def failed_import(name, *args, **kwargs):
        if name == "some_module":
            raise ImportError("Module not available")
        return original_import(name, *args, **kwargs)

    # Backup and replace __import__
    original_import = builtins.__import__
    monkeypatch.setattr(builtins, "__import__", failed_import)

    # Clear module cache
    monkeypatch.delitem(sys.modules, "my_module", raising=False)

    # Test the import failure
    with pytest.raises(ImportError, match="Module not available"):
        import my_module
```

### Testing Conditional Imports

```python
import pytest
from unittest.mock import patch

def test_conditional_import_success():
    """Test successful conditional import."""
    with patch.dict('sys.modules', {'optional_module': None}):
        # Simulate successful import
        import optional_module
        assert optional_module is not None

def test_conditional_import_failure():
    """Test graceful handling of missing optional dependencies."""
    with patch.dict('sys.modules', {}, clear=True):
        # Remove module from sys.modules to simulate import failure
        if 'optional_module' in sys.modules:
            del sys.modules['optional_module']

        # Test that code handles missing module gracefully
        result = function_that_uses_optional_module()
        assert result == "fallback_value"
```

## Testing Import Retries

```python
import time
import pytest
from unittest.mock import patch, call

def test_import_retry_mechanism(monkeypatch):
    """Test import retry logic with exponential backoff."""
    import_attempts = []

    def failing_import(name, *args, **kwargs):
        import_attempts.append(name)
        if len(import_attempts) < 3:
            raise ImportError(f"Attempt {len(import_attempts)} failed")
        return type('MockModule', (), {})()

    original_import = builtins.__import__
    monkeypatch.setattr(builtins, "__import__", failing_import)

    # Test retry mechanism
    result = retry_import("my_module", max_attempts=3)

    assert len(import_attempts) == 3
    assert result is not None
```

## Testing Module Dependencies

```python
import pytest
from importlib import import_module

def test_module_dependencies():
    """Test that all required modules can be imported."""
    required_modules = [
        'requests',
        'pathlib',
        'dataclasses',
        'typing'
    ]

    for module_name in required_modules:
        try:
            module = import_module(module_name)
            assert module is not None
        except ImportError as e:
            pytest.fail(f"Required module {module_name} could not be imported: {e}")

def test_optional_dependencies():
    """Test optional dependencies are handled correctly."""
    optional_modules = [
        'pandas',
        'numpy',
        'matplotlib'
    ]

    available_modules = []
    for module_name in optional_modules:
        try:
            module = import_module(module_name)
            available_modules.append(module_name)
        except ImportError:
            # Optional module not available, skip
            continue

    # Test that at least some optional modules are available
    assert len(available_modules) >= 0
```

## Testing Import Side Effects

```python
import pytest
from unittest.mock import patch

def test_import_side_effects():
    """Test that imports don't have unexpected side effects."""
    # Capture state before import
    before_import = capture_current_state()

    # Perform import
    import my_module

    # Capture state after import
    after_import = capture_current_state()

    # Verify no unexpected changes
    assert before_import == after_import

def test_import_initialization():
    """Test that module initialization works correctly."""
    with patch('my_module.initialize') as mock_init:
        import my_module
        mock_init.assert_called_once()
```

## Best Practices

- **Use `monkeypatch`** for temporary import modifications
- **Clear module cache** when testing import retries
- **Test both success and failure paths** for conditional imports
- **Mock external dependencies** that may not be available
- **Verify import side effects** don't break existing functionality
- **Use parameterized tests** for testing multiple import scenarios
