[project]
name = "{{ project_slug }}"
version = "0.0.1"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "pydantic>=2.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug }}", "src/agent_work"]

[project.scripts]
agent-work = "agent_work.cli:main"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "--cov={{ project_slug }} --cov-report=term-missing"

[tool.coverage.run]
source = ["{{ project_slug }}"]
omit = ["tests/*", "*/tests/*"]

[tool.uv.sources]
{{ project_slug }} = { workspace = true }

[tool.ruff.lint]
ignore = ["E501","G004","D203","D213","COM812","S603"]

[tool.ruff.lint.per-file-ignores]
"tests/*.py" = ["S101","S105","S106","EXE","SLF001","PLR0913"]
# T201: print is intentional — outputs JSON to stdout and warnings to stderr.
# EXE: has shebang but is invoked via `uv run python` in CI.
"tests/helpers/yamllint_to_json.py" = ["T201","EXE"]

[tool.tox]
requires = ["tox>=4.19", "tox-uv>=1.20"]
env_list = ["py311", "py314"]

[tool.tox.env.py311]
description = "Run tests with Python 3.11"
set_env = { COVERAGE_FILE = ".coverage.py311" }
deps = [
    "hypothesis>=6.0",
    "pytest>=8.3.5",
    "pytest-cov>=6.1.1",
    "pytest-mock>=3.14.0",
    "pytest-randomly>=3.15.0",
    "pytest-subprocess>=1.5.3",
    "pytest-timeout>=2.2.0",
    "requests-mock>=1.12.1",
]
commands = [["pytest", "--cov={{ project_slug }}", "--cov-report=xml:coverage-py311.xml", "--cov-report=term-missing", "--cov-fail-under=85", "-v", "--junitxml=test-results-py311.xml", "-o", "junit_suite_name=py311"]]

[tool.tox.env.py314]
description = "Run tests with Python 3.14"
set_env = { COVERAGE_FILE = ".coverage.py314" }
deps = [
    "hypothesis>=6.0",
    "pytest>=8.3.5",
    "pytest-cov>=6.1.1",
    "pytest-mock>=3.14.0",
    "pytest-randomly>=3.15.0",
    "pytest-subprocess>=1.5.3",
    "pytest-timeout>=2.2.0",
    "requests-mock>=1.12.1",
]
commands = [["pytest", "--cov={{ project_slug }}", "--cov-report=xml:coverage-py314.xml", "--cov-report=term-missing", "--cov-fail-under=85", "-v", "--junitxml=test-results-py314.xml", "-o", "junit_suite_name=py314"]]

[dependency-groups]
test = [
    "hypothesis>=6.0",
    "pytest>=8.3.5",
    "pytest-cov>=6.1.1",
    "pytest-mock>=3.14.0",
    "pytest-randomly>=3.15.0",
    "pytest-subprocess>=1.5.3",
    "pytest-timeout>=2.2.0",
    "requests-mock>=1.12.1",
]
dev = [
    "{{ project_slug }}",
    {include-group = "test"},
    "kingfisher-bin>=1.112.0",
    "pre-commit>=4.6.2",
    "ty>=0.0.1a11",
    "yamllint>=1.37.1",
    "ruff>=0.16.4",
    "tox>=4.27.0",
    "tox-uv>=1.20",
]
